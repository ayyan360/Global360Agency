# Test configuration — MUST point at a separate, disposable database.
NODE_ENV=test
PORT=5099
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/global360_test
JWT_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=storage/test-private
ENABLE_JOBS=false
RATE_LIMIT_DISABLED=true
LOG_LEVEL=silent
