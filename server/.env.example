# ---------------------------------------------------------------
# Global360 server configuration. Copy to server/.env and fill in.
# Never commit real credentials.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Origin(s) of the React app, comma-separated. Used for CORS.
CLIENT_URL=http://localhost:5173
# Public URL used in certificate verification links/QR codes (defaults to first CLIENT_URL).
PUBLIC_APP_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/global360
DATABASE_SSL=false
# Optional CA certificate for managed PostgreSQL providers with a private CA.
DATABASE_SSL_CA=
DB_LOGGING=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN_HOURS=24

# Cookies — set COOKIE_SECURE=true in production (HTTPS).
# Use COOKIE_SAMESITE=none only when the API and client are on different sites (requires COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Number of reverse-proxy hops to trust (e.g. 1 behind a load balancer). Leave empty locally.
TRUST_PROXY=

LOG_LEVEL=info

# Groq-powered learning assistant (leave empty to disable assistant replies).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# File storage: local (development), s3 (production, any S3-compatible service) or none (uploads disabled).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=storage/private
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=300

# Background jobs (task-release notifications, deadline reminders, internship completion & certificates).
ENABLE_JOBS=true

# Serve the built React app (client/dist) from Express — useful for single-server deployments.
SERVE_CLIENT=false

# Shown on generated certificates. Leave the signatory empty unless an authorized person has agreed.
CERTIFICATE_ISSUER_NAME=Global360 Internship Program
CERTIFICATE_SIGNATORY_NAME=
CERTIFICATE_SIGNATORY_TITLE=

# Initial admin, used only by `npm run db:create-admin`. Choose a strong, unique password.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email delivery is not configured by default; in-app notifications are always stored.
EMAIL_PROVIDER=none
