{
  "name": "@global360/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --watch-path=src src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/scripts/migrate.js up",
    "db:migrate:undo": "node src/scripts/migrate.js down",
    "db:migrate:status": "node src/scripts/migrate.js status",
    "db:seed": "node src/scripts/seed.js",
    "db:create-admin": "node src/scripts/createAdmin.js",
    "jobs:run": "node src/scripts/runJobs.js",
    "lint": "eslint src tests",
    "test": "NODE_ENV=test node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  }
}
