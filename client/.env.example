# Base URL of the API. Leave as /api when the client is served from the same origin as the API
# (Vite dev proxy, or Express SERVE_CLIENT=true). Set a full URL (e.g. https://api.example.com/api)
# only when the API is on a different origin — then configure CLIENT_URL/CORS and cookies on the server.
VITE_API_BASE_URL=/api

# Dev-only: where Vite proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:5000

# Never put secrets in VITE_* variables — they are embedded in the public JavaScript bundle.
